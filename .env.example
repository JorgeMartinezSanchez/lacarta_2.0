# PostgreSQL
POSTGRES_DB=lacarta
POSTGRES_USER=lacarta
POSTGRES_PASSWORD=cambia-esta-contraseña
POSTGRES_HOST=db

# Flask
DATABASE_URL=postgresql+psycopg://lacarta:cambia-esta-contraseña@db:5432/lacarta

SECRET_KEY=cambia-esto-por-un-valor-aleatorio-largo

BEHIND_PROXY=1
SESSION_COOKIE_SECURE=1

LOG_LEVEL=INFO

# Auth0
AUTH0_DOMAIN=tu-tenant.us.auth0.com
AUTH0_AUDIENCE=https://lacarta-api
AUTH0_CLIENT_ID=tu-client-id
AUTH0_CLIENT_SECRET=tu-client-secret

# Django
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=cambia-esta-contraseña
# Solo en tu .env LOCAL de desarrollo (docker-compose.dev.yml): activa DEBUG y
# permite el login del admin por http://localhost. En el servidor, déjalo en 0.
DJANGO_DEBUG=0
